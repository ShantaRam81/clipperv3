{
  "version": 2,
  "builds": [
    { "src": "api/[...path].js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/remote-clips/(.*)", "dest": "http://144.31.184.79:8082/clips/$1" },
    { "src": "/api/(.*)", "dest": "/api/[...path].js" },
    { "src": "/(.*\\.(?:css|js|json|svg|png|jpg|jpeg|webm|mp4))", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
